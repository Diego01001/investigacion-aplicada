@{
    ViewData["Title"] = "Reserva de Espacios";
}

<link rel="stylesheet" href="~/css/reservas.css" />

<div class="container py-5 animate-fade">
    <!-- Header Hero -->
    <div class="row mb-5">
        <div class="col-12 text-center">
            <h1 class="display-4 fw-bold tracking-tight mb-3">
                <span class="text-primary">Gestión Universitaria</span> de Reservas
            </h1>
            <p class="lead text-muted mx-auto" style="max-width: 600px;">
                Optimice el uso de espacios compartidos con un sistema inteligente, rápido y eficiente para toda la comunidad académica.
            </p>
        </div>
    </div>

    <!-- Panel de Filtros -->
    <div class="card border-0 mb-5 p-2">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">FECHA</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0"><i class="far fa-calendar-alt text-primary"></i></span>
                        <input type="date" id="filtroFecha" class="form-control border-start-0 ps-0" />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">ESPACIO ACADÉMICO</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0"><i class="fas fa-building text-primary"></i></span>
                        <select id="filtroEspacio" class="form-select border-start-0 ps-0">
                            <option value="">Todos los espacios</option>
                            @foreach (var e in ViewBag.Espacios)
                            {
                                <option value="@e.Id">@e.Nombre</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">ESTADO</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0"><i class="fas fa-info-circle text-primary"></i></span>
                        <select id="filtroEstado" class="form-select border-start-0 ps-0">
                            <option value="">Cualquier estado</option>
                            <option value="Vigente">Vigente</option>
                            <option value="Cancelada">Cancelada</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <button id="btnLimpiarFiltros" class="btn btn-outline-primary w-100 py-2">
                        <i class="fas fa-sync-alt me-2"></i> Limpiar Filtros
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Listado Principal -->
    <div class="card border-0 overflow-hidden">
        <div class="card-header bg-white py-4 px-4 d-flex justify-content-between align-items-center">
            <div>
                <h4 class="mb-0 fw-bold">Panel de Reservas</h4>
                <p class="text-muted small mb-0">Consulte y gestione las solicitudes del día</p>
            </div>
            <button class="btn btn-primary px-4 py-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalNuevaReserva">
                <i class="fas fa-plus-circle me-2"></i> Crear Reserva
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>IDENTIFICADOR</th>
                            <th>SOLICITANTE</th>
                            <th>ESPACIO</th>
                            <th>FECHA Y HORARIO</th>
                            <th>ESTADO</th>
                            <th class="text-center">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <!-- AJAX Content -->
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>
                                <span class="text-muted">Cargando registros...</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Registro Modernizado -->
<div class="modal fade" id="modalNuevaReserva" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-2xl">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold fs-4 mb-0">Nueva Reservación</h5>
                    <p class="text-white-50 small mb-0">Complete los datos para apartar un espacio</p>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="reservaForm" class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Nombre del Solicitante</label>
                        <input type="text" id="Solicitante" class="form-control" placeholder="Ej. Juan Pérez" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Correo Institucional</label>
                        <input type="email" id="Correo" class="form-control" placeholder="usuario@universidad.edu" required />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label fw-semibold">Seleccionar Espacio</label>
                        <select id="EspacioId" class="form-select" required>
                            <option value="">Seleccione una ubicación...</option>
                            @foreach (var e in ViewBag.Espacios)
                            {
                                <option value="@e.Id">@e.Nombre (@e.Capacidad pers.) - @e.Ubicacion</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Fecha</label>
                        <input type="date" id="Fecha" class="form-control" required min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Hora de Inicio</label>
                        <input type="time" id="HoraInicio" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Hora de Finalización</label>
                        <input type="time" id="HoraFin" class="form-control" required />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label fw-semibold">Propósito del Uso</label>
                        <textarea id="Motivo" class="form-control" rows="3" placeholder="Indique brevemente para qué utilizará el espacio" required></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-link text-muted text-decoration-none px-4" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btnGuardar" class="btn btn-primary shadow px-5">Confirmar Reserva</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/reservas.js"></script>
}
